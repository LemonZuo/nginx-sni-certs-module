ngx_addon_name=ngx_http_ssl_cert_dir_module

# 不依赖任何外部库：JSON 清单由模块自带的解析器处理
# （ngx_http_ssl_cert_json.c），只需要 nginx 和 OpenSSL

if test -n "$ngx_module_link"; then
    ngx_module_type=HTTP
    ngx_module_name=ngx_http_ssl_cert_dir_module
    ngx_module_srcs="$ngx_addon_dir/ngx_http_ssl_cert_dir_module.c \
$ngx_addon_dir/ngx_http_ssl_cert_json.c"
    . auto/module
else
    HTTP_MODULES="$HTTP_MODULES ngx_http_ssl_cert_dir_module"
    NGX_ADDON_SRCS="$NGX_ADDON_SRCS $ngx_addon_dir/ngx_http_ssl_cert_dir_module.c \
$ngx_addon_dir/ngx_http_ssl_cert_json.c"
fi
